# Copy to infra/.env (git-ignored) and fill in. Compose refuses to start
# without RABBITMQ_PASSWORD; everything else is optional and degrades to
# fixtures / fakes / logging when absent.
RABBITMQ_USER=soteria
RABBITMQ_PASSWORD=

# Live store (omit both to run the domain services on fixtures)
SHOPIFY_SHOP=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01
QUARANTINE_LOCATION=Quarantine

# LLM (omit to use the deterministic fakes)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Notifications (omit to log instead of send)
SLACK_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=

# Audit timestamping (1 = hash-chain only, no TSA call)
TSA_DISABLED=1
CONSENT_SECRET=
